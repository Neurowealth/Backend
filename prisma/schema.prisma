  endpoint UserWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, userEventSeq])
  @@index([endpointId])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
  @@map("user_webhook_deliveries")
}

// ─────────────────────────────────────────────────────────────────────────────
// User event store for SSE / event sourcing (#events/store.ts, #sse/handler.ts)
// ─────────────────────────────────────────────────────────────────────────────

model UserEvent {
  id        String   @id @default(uuid())
  userId    String
  seq       BigInt
  topic     String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId, seq])
  @@index([userId, topic])
  @@index([createdAt])
  @@map("user_events")
}

model UserEventSequence {
  userId    String   @id
  lastSeq   BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@map("user_event_sequences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Treasury sweep policy (#treasury/policy.ts)
// ─────────────────────────────────────────────────────────────────────────────

model TreasurySweepPolicy {
  id                    String       @id @default(uuid())
  fromTier              TreasuryTier
  toTier                TreasuryTier
  maxHotBalance         Decimal      @db.Decimal(36, 18)
  sweepIntervalMinutes  Int
  minSweepAmount        Decimal      @db.Decimal(36, 18)
  requiresApprovalAbove Decimal?     @db.Decimal(36, 18)
  version               Int          @default(1)
  isActive              Boolean      @default(true)
  createdBy             String
  createdAt             DateTime     @default(now())

  @@index([fromTier, toTier])
  @@index([isActive])
  @@map("treasury_sweep_policies")
}

// ─────────────────────────────────────────────────────────────────────────────
// Treasury accounts (#jobs/treasurySweep.ts, #outbox/executors.ts)
// ─────────────────────────────────────────────────────────────────────────────

model TreasuryAccount {
  id          String       @id @default(uuid())
  publicKey   String
  tier        TreasuryTier
  isActive    Boolean      @default(true)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sweeps          TreasurySweep[]
  signerRotations SignerRotation[]

  @@index([tier])
  @@index([isActive])
  @@map("treasury_accounts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Treasury sweeps (#jobs/treasurySweep.ts)
// ─────────────────────────────────────────────────────────────────────────────

model TreasurySweep {
  id         String       @id @default(uuid())
  fromTier   TreasuryTier
  toTier     TreasuryTier
  asset      String
  amount     Decimal      @db.Decimal(36, 18)
  status     String       @default("PENDING")
  reason     String
  outboxOpId String?
  accountId  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  account   TreasuryAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  envelopes MultisigEnvelope[]

  @@index([status])
  @@index([fromTier, toTier])
  @@index([createdAt])
  @@map("treasury_sweeps")
}

// ─────────────────────────────────────────────────────────────────────────────
// Multisig envelopes for sweep authorisation (#jobs/treasurySweep.ts)
// ─────────────────────────────────────────────────────────────────────────────

model MultisigEnvelope {
  id         String    @id @default(uuid())
  sweepId    String
  publicKey  String
  threshold  Int
  signatures Json[]
  status     String    @default("PENDING")
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sweep TreasurySweep @relation(fields: [sweepId], references: [id], onDelete: Cascade)

  @@index([sweepId])
  @@index([status])
  @@index([expiresAt])
  @@map("multisig_envelopes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Signer rotation with dual-active window (#treasury/signerRotation.ts)
// ─────────────────────────────────────────────────────────────────────────────

model SignerRotation {
  id                String    @id @default(uuid())
  treasuryAccountId String
  oldSignerKey      String
  newSignerKey      String
  status            String    @default("DUAL_ACTIVE") // DUAL_ACTIVE | FINALIZED
  dualActiveSince   DateTime?
  finalizedAt       DateTime?
  initiatedBy       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  treasuryAccount TreasuryAccount @relation(fields: [treasuryAccountId], references: [id], onDelete: Cascade)

  @@index([treasuryAccountId])
  @@index([status])
  @@index([createdAt])
  @@map("signer_rotations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification preferences (#notifications/service.ts)
// ─────────────────────────────────────────────────────────────────────────────

model NotificationPreference {
  id         String   @id @default(uuid())
  userId     String
  channel    String
  category   String
  enabled    Boolean  @default(true)
  quietHours Json?
  frequency  String?
  updatedBy  String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
  @@index([userId])
  @@index([channel])
  @@index([category])
  @@map("notification_preferences")
}

model NotificationPreferenceAuditLog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  channel       String
  category      String
  previousValue Boolean
  newValue      Boolean
  changedBy     String
  changedAt     DateTime @default(now())
  metadata      Json?

  @@index([userId])
  @@index([changedAt])
  @@map("notification_preference_audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Recurring Withdrawal Plans (#551)
// ─────────────────────────────────────────────────────────────────────────────

enum WithdrawalAmountMode {
  FIXED
  YIELD_ONLY
  PERCENT_OF_BALANCE
}

enum RecurringWithdrawalPlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model RecurringWithdrawalPlan {
  id                 String                        @id @default(uuid())
  userId             String
  destinationAddress String
  assetSymbol        String
  amountMode         WithdrawalAmountMode          @default(FIXED)
  amount             Decimal?                      @db.Decimal(36, 18)
  percentage         Decimal?                      @db.Decimal(12, 6)
  cadence            DepositCadence
  nextRunAt          DateTime
  status             RecurringWithdrawalPlanStatus @default(ACTIVE)
  minAmount          Decimal?                      @db.Decimal(36, 18)
  lastRunAt          DateTime?
  lastRunStatus      String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, nextRunAt])
  @@map("recurring_withdrawal_plans")
}

// ─────────────────────────────────────────────────────────────────────────────
// Support Ticket System (#552)
// ─────────────────────────────────────────────────────────────────────────────

enum TicketCategory {
  ACCOUNT
  TRANSACTION
  TAX
  TECHNICAL
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id          String         @id @default(uuid())
  userId      String
  subject     String
  category    TicketCategory
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  assignedTo  String?
  contextRef  String?
  slaBreached Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([assignedTo])
  @@index([slaBreached])
  @@map("support_tickets")
}

enum MessageAuthorRole {
  USER
  ADMIN
}

model TicketMessage {
  id             String            @id @default(uuid())
  ticketId       String
  authorUserId   String?
  authorRole     MessageAuthorRole @default(USER)
  body           String            @db.Text
  attachmentRefs String[]          @default([])
  internal       Boolean           @default(false)
  createdAt      DateTime          @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([ticketId, internal])
  @@map("ticket_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// WebAuthn / Passkey Credentials (#553)
// ─────────────────────────────────────────────────────────────────────────────

model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  signCount    BigInt    @default(0)
  deviceLabel  String?
  transports   String[]  @default([])
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@map("webauthn_credentials")
}

// One-time, session-bound ceremonies shared across application instances.
model WebAuthnChallenge {
  id        String   @id @default(uuid())
  challenge String   @unique
  purpose   String
  userId    String?
  sessionId String?
  expiresAt DateTime

  @@index([expiresAt])
  @@map("webauthn_challenges")
}


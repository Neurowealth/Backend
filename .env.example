```env
# ============================================================
# Application Environment
# ============================================================

# Runtime environment for the backend application.
# "development" enables development-specific behavior.
NODE_ENV=development

# Port on which the backend API will run.
PORT=3000


# ============================================================
# Stellar / Blockchain Configuration
# ============================================================

# Stellar network used by the application.
# Options typically include testnet or mainnet.
STELLAR_NETWORK=testnet

# Multi-endpoint Stellar RPC URLs (comma-separated list) for automatic failover (#447).
# When configured, requests try the primary endpoint first and automatically fail over
# to secondary endpoints in order upon failure or if circuit breaker is open.
# Takes precedence over STELLAR_RPC_URL. See docs/RUNBOOK.md § 3.
# STELLAR_RPC_URLS=https://soroban-testnet.stellar.org,https://soroban-mainnet.stellar.org

# Optional custom Stellar RPC endpoint (single URL fallback).
# Legacy fallback used when STELLAR_RPC_URLS is unset.
# By default, the application derives the RPC URL from STELLAR_NETWORK.
# Set this only when using a custom RPC endpoint, self-hosted node,
# or another development network.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ============================================================
# Stellar RPC Client & Circuit Breaker Configuration (#447)
# ============================================================

# Outgoing HTTP request timeout per RPC call in milliseconds.
HTTP_CLIENT_TIMEOUT_MS=10000

# Maximum retry attempts per RPC endpoint before initiating failover.
HTTP_CLIENT_MAX_RETRIES=3

# Initial delay in milliseconds for exponential backoff between retries.
HTTP_CLIENT_BASE_DELAY_MS=200

# Maximum delay cap in milliseconds for exponential backoff.
HTTP_CLIENT_MAX_DELAY_MS=10000

# Consecutive failure threshold before an RPC endpoint's circuit breaker opens.
HTTP_CLIENT_CIRCUIT_BREAKER_THRESHOLD=5

# Cooldown duration in milliseconds before an open circuit breaker enters half-open.
HTTP_CLIENT_CIRCUIT_BREAKER_RESET_MS=30000


# Stellar secret key for the application's agent wallet.
# Replace this placeholder with a valid development/testnet secret key.
STELLAR_AGENT_SECRET_KEY=your_agent_stellar_secret_key_here

# Contract ID of the deployed Vault contract.
# Replace this placeholder with the appropriate testnet contract ID.
VAULT_CONTRACT_ID=your_deployed_contract_id_here

# Stellar testnet USDC token contract/address.
# Replace this placeholder with the correct testnet USDC contract address.
USDC_TOKEN_ADDRESS=testnet_usdc_contract_address_here

# Portfolio market-volatility circuit breaker threshold and master switch.
MARKET_VOLATILITY_BREAKER_ENABLED=true
MARKET_VOLATILITY_BREAKER_THRESHOLD_PCT=75

# ============================================================
# AI / External API Configuration
# ============================================================

# Anthropic API key used for AI functionality.
# Obtain a development API key from the Anthropic console.
ANTHROPIC_API_KEY=your-anthropic-key-here

# Brian API key used for Brian-related integrations.
# Obtain a key from the Brian platform if this integration is enabled.
BRIAN_API_KEY=get_from_brianknows.org

# OpenAI API key used for OpenAI-related functionality.
OPENAI_API_KEY=your-openai-key-here


# ============================================================
# Database Configuration
# ============================================================

# PostgreSQL connection URL for local development.
# Keep this consistent with the individual DB_* variables below.
DATABASE_URL=postgresql://user:password@localhost:5432/neuro_backend

# PostgreSQL database host.
DB_HOST=localhost

# PostgreSQL database port.
DB_PORT=5432

# PostgreSQL database username.
DB_USER=postgres

# PostgreSQL database password.
# Use a secure local development password where appropriate.
DB_PASSWORD=password

# Name of the local development database.
DB_NAME=neuro_backend


# ============================================================
# Wallet Encryption
# ============================================================

# Encryption key used to protect encrypted wallet/private-key data.
# IMPORTANT: Generate a strong random value for development.
#
# Generate a 32-byte hexadecimal key with:
# openssl rand -hex 32
WALLET_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32


# ============================================================
# Authentication / JWT Configuration
# ============================================================

# Secret used to sign and verify JWT access tokens.
# Use a strong random value even during development.
JWT_SECRET=your-secret-key-here

# Lifetime of an access token.
JWT_EXPIRY=24h

# Separate secret used to sign and verify refresh tokens.
REFRESH_TOKEN_SECRET=refresh-secret-key


# ============================================================
# Logging Configuration
# ============================================================

# Minimum log level emitted by the application.
# Common values include debug, info, warn, and error.
LOG_LEVEL=info

# Log output format.
# JSON is useful when logs are consumed by structured logging tools.
LOG_FORMAT=json


# ============================================================
# HTTP / Server Configuration
# ============================================================

# Maximum amount of time the server waits for an HTTP request
# before timing out, in milliseconds.
SERVER_TIMEOUT=30000

# Maximum size of incoming HTTP request bodies.
MAX_REQUEST_SIZE=10mb


# ============================================================
# CORS Configuration
# ============================================================

# Comma-separated list of frontend origins allowed to make
# cross-origin requests to the backend. Read as CORS_ORIGINS,
# falling back to ALLOWED_ORIGINS.
#
# NODE_ENV=development / test
#   Any origin is allowed; the list below is documentation only.
# NODE_ENV=staging / production
#   The allowlist is enforced. Requests from any other origin are
#   rejected with 403, and the process refuses to start if the list
#   is empty or contains a wildcard.
#
# Each entry must be an absolute origin — scheme, host, and port if
# not the scheme default. A trailing slash is tolerated and ignored.
#
# Local development frontends:
# - http://localhost:3000
# - http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Production frontends. Do NOT use '*' outside development: with
# credentialed requests enabled, a wildcard allowlist lets any
# website read authenticated responses.
# CORS_ORIGINS=https://app.neurowealth.io,https://admin.neurowealth.io

# Optional single-label subdomain wildcard, when a pre-release build
# needs its own origin without a redeploy. Matches exactly one label
# (https://staging.neurowealth.io) — never the apex, never nested
# subdomains.
# CORS_ORIGINS=https://*.neurowealth.io

# Whether to reject requests that carry no Origin header. Non-browser
# clients (curl, k8s probes, server-to-server calls) send none, and are
# governed by auth and rate limiting rather than CORS.
# Defaults to true in production, false in staging and below.
# CORS_REQUIRE_ORIGIN=true


# ============================================================
# Real-time WebSocket Streaming (#316)
# ============================================================
#
# See docs/WEBSOCKET_STREAMING.md for the complete WebSocket
# streaming configuration and implementation details.
#
# All WebSocket settings below are optional.
# If a variable is not provided, the application uses its
# corresponding default value.

# WebSocket endpoint path.
WS_PATH=/api/v1/ws

# Interval between WebSocket heartbeat/ping checks, in milliseconds.
WS_HEARTBEAT_INTERVAL_MS=30000

# Maximum amount of time an idle WebSocket connection can remain
# inactive before it is closed, in milliseconds.
WS_IDLE_TIMEOUT_MS=90000

# Maximum number of events that can be buffered for a connection.
WS_MAX_BUFFERED_EVENTS=256

# Maximum total size of buffered events, in bytes.
WS_MAX_BUFFERED_BYTES=1048576

# Maximum number of simultaneous WebSocket connections allowed
# for a single user.
WS_MAX_CONNECTIONS_PER_USER=5

# Maximum number of handshake attempts allowed within the
# configured handshake window.
WS_HANDSHAKE_MAX=30

# Time window used for limiting WebSocket handshake attempts,
# in milliseconds.
WS_HANDSHAKE_WINDOW_MS=60000

# Maximum number of messages a client may send within the
# configured message rate-limit window.
WS_MESSAGE_MAX=50

# Message rate-limit window, in milliseconds.
WS_MESSAGE_WINDOW_MS=10000

# Maximum size of an individual WebSocket message, in bytes.
WS_MAX_MESSAGE_BYTES=4096

# Maximum number of events that can be replayed when a client
# reconnects and requests missed events.
WS_REPLAY_MAX_EVENTS=1000

# Interval at which the server re-checks the user's session,
# in milliseconds.
WS_SESSION_RECHECK_MS=60000

# Time window used to coalesce multiple events into a single
# delivery, in milliseconds.
WS_COALESCE_WINDOW_MS=250

# Delay before retrying a WebSocket drain operation,
# in milliseconds.
WS_DRAIN_RETRY_AFTER_MS=2000


# ============================================================
# Email / Mail Configuration
# ============================================================

# Mail provider strategy. Priority: AWS SES > SMTP > Mock (in-memory).
# Configure either SES or SMTP variables below based on your provider choice.

# AWS SES Configuration (if using AWS SES)
# AWS region for SES service
# AWS_REGION=us-east-1

# Sender email address for AWS SES
# SES_FROM_EMAIL=noreply@yourdomain.com

# AWS credentials (AWS SDK will use default credential chain if not set)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# Or use AWS_PROFILE=your_profile_name

# SMTP Configuration (if using SMTP)
# SMTP server hostname
# SMTP_HOST=smtp.gmail.com

# SMTP server port (typically 587 for TLS or 465 for SSL)
# SMTP_PORT=587

# SMTP authentication username
# SMTP_USER=your-email@gmail.com

# SMTP authentication password
# SMTP_PASS=your-app-password

# Whether to use TLS/SSL for SMTP connection (default: true)
# Set to 'false' to disable TLS
# SMTP_SECURE=true

# Sender email address for SMTP
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# SMTP webhook signing secret (for validating incoming webhook signatures)
# SMTP_WEBHOOK_SECRET=your-webhook-signing-secret


# ============================================================
# Redis / Cross-Pod Event Fan-out
# ============================================================

# Connection URL for the Redis instance.
# When running locally via docker-compose this is:
REDIS_URL=redis://localhost:6379

# Redis pub/sub channel used to distribute user events across
# multiple application pods/instances.
#
# Requires REDIS_URL to be configured.
# Without Redis, event delivery remains pod-local and clients
# can recover missed events using `resume afterSeq`.
WS_EVENT_CHANNEL=neurowealth:user-events


# ============================================================
# Durable User Event Stream Retention
# ============================================================

# Maximum age of persisted user events.
# Events older than this value can be removed during retention cleanup.
RETENTION_USER_EVENTS_DAYS=7

# Maximum number of persisted events retained per user.
# Retention is bounded by both age and this per-user row limit.
USER_EVENT_STREAM_MAX_PER_USER=5000


# Required Startup Keys (#497 environment parity)
# ============================================================
# Both are validated by src/config/env.ts at boot; leaving them
# out makes the process refuse to start.

# At least 32 characters of entropy (openssl rand -base64 48).
JWT_SEED=generate_with_openssl_rand_base64_48

# WhatsApp/Telegram delivery channel credential.
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# ============================================================
# Rate limiting (#473)
# ============================================================
# Every limiter is a sliding window. Limits are enforced per principal
# (API key id, then user id, then client IP) rather than per IP alone, so a
# shared NAT address no longer throttles unrelated users and a single abusive
# key cannot hide behind a rotating IP.

# Global ceiling for all traffic.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Unauthenticated callers to the public API. Strict on purpose: no identity has
# been proven, so this budget exists to slow enumeration and scraping.
ANONYMOUS_RATE_LIMIT_WINDOW_MS=900000
ANONYMOUS_RATE_LIMIT_MAX=60

# Signed-in users and API keys. Generous, because the identity behind the
# request is already known.
AUTHENTICATED_RATE_LIMIT_WINDOW_MS=900000
AUTHENTICATED_RATE_LIMIT_MAX=600

# Credential and fund-movement endpoints (/withdraw, /deposit, /keys, key
# rotation). Applied in addition to the caller's normal budget.
SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX=10

# Per-tier overrides for the /auth endpoints (IP-keyed: credential stuffing
# happens before any identity exists).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# /api/admin/* — management surface.
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=10

# Inbound provider webhooks (Twilio, Telegram) — spoofing / replay defence.
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=30

# CPU-bound endpoints: portfolio optimiser and strategy simulation.
OPTIMIZER_RATE_LIMIT_WINDOW_MS=60000
OPTIMIZER_RATE_LIMIT_MAX=5
SIMULATE_RATE_LIMIT_WINDOW_MS=60000
SIMULATE_RATE_LIMIT_MAX=6

# Service-to-service calls from other internal components.
INTERNAL_RATE_LIMIT_WINDOW_MS=60000
INTERNAL_RATE_LIMIT_MAX=500

# Comma-separated IPs that bypass rate limiting entirely (k8s probes, CI).
# Keep this tight: every entry is an unauthenticated hole in the limiter.
# TRUSTED_IPS=10.0.0.5,10.0.0.6

# Express `trust proxy`. Required for a correct req.ip behind an ingress/LB,
# and rate limiting keys on req.ip — a wrong setting here makes the limiter
# treat every client as one shared address.
# TRUST_PROXY=1
```

```env
# ============================================================
# Application Configuration
# ============================================================

# Application environment.
# Enables production-specific behavior and optimizations.
NODE_ENV=production

# Port on which the backend API listens.
PORT=3000


# ============================================================
# CORS Configuration
# ============================================================

# Comma-separated list of frontend origins allowed to access
# the backend API from a browser. Enforced in production and
# staging: a request from any other origin is rejected with 403,
# and the process refuses to start if this list is empty.
#
# Do NOT use '*'. Credentialed requests are enabled, so a wildcard
# allowlist lets any website read authenticated responses.
CORS_ORIGINS=https://app.neurowealth.io,https://admin.neurowealth.io

# Optional single-label subdomain wildcard for pre-release builds.
# Matches exactly one label — never the apex, never nested
# subdomains.
# CORS_ORIGINS=https://*.neurowealth.io

# Reject requests that carry no Origin header. Non-browser clients
# (curl, k8s probes, server-to-server) send none. Defaults to true
# in production; set false if browser clients omit the header.
# CORS_REQUIRE_ORIGIN=true


# ============================================================
# Database Configuration
# ============================================================

# PostgreSQL connection URL for the production database.
# IMPORTANT: Replace this with the actual production database
# credentials and keep the value secret.
DATABASE_URL=postgresql://user:password@localhost:5432/neuro_backend_prod

# Production PostgreSQL database host.
DB_HOST=localhost

# PostgreSQL database port.
DB_PORT=5432

# PostgreSQL database username.
DB_USER=user

# PostgreSQL database password.
# IMPORTANT: This is a production secret and should not be
# committed to source control.
DB_PASSWORD=password

# Name of the production PostgreSQL database.
DB_NAME=neuro_backend_prod


# ============================================================
# JWT / Authentication Configuration
# ============================================================

# Secret used to sign and verify access JWTs.
# IMPORTANT: Use a strong, randomly generated secret in production.
# Never commit the real value to source control.
JWT_SECRET=your-secret-key-here

# Lifetime of an access JWT.
JWT_EXPIRY=24h

# Secret used to sign and verify refresh tokens.
# IMPORTANT: Use a separate strong secret from JWT_SECRET.
REFRESH_TOKEN_SECRET=refresh-secret-key


# ============================================================
# AI / External API Configuration
# ============================================================

# Anthropic API key used by the backend for AI functionality.
# IMPORTANT: Store the real production key securely.
# ANTHROPIC_API_KEY=get_from_console.anthropic.com

# Brian API key for blockchain/AI-related integrations.
# Obtain the key from the Brian platform when required.
# BRIAN_API_KEY=get_from_brianknows.org

# Production Anthropic API key.
# IMPORTANT: Replace the placeholder with the real secret
# and never commit it to source control.
ANTHROPIC_API_KEY=your-anthropic-key-here

# Production OpenAI API key.
# IMPORTANT: Replace the placeholder with the real secret
# and never commit it to source control.
OPENAI_API_KEY=your-openai-key-here


# ============================================================
# Logging Configuration
# ============================================================

# Logging level for the production environment.
# "warn" reduces noisy informational logs while retaining
# warnings and errors.
LOG_LEVEL=warn

# Log output format.
# JSON is suitable for production log aggregation and
# monitoring systems.
LOG_FORMAT=json


# ============================================================
# HTTP / Server Configuration
# ============================================================

# Maximum amount of time the server will wait for an HTTP
# request before timing out, in milliseconds.
SERVER_TIMEOUT=30000

# Maximum size allowed for incoming HTTP request bodies.
MAX_REQUEST_SIZE=10mb

# ============================================================
# Core Startup Keys (#497 environment parity)
# ============================================================
# Required by src/config/env.ts at boot — `npm run env:parity`
# fails CI when any of these goes missing from an environment.

STELLAR_NETWORK=mainnet
STELLAR_AGENT_SECRET_KEY=your_agent_stellar_secret_key_here
VAULT_CONTRACT_ID=your_deployed_contract_id_here
USDC_TOKEN_ADDRESS=testnet_usdc_contract_address_here
WALLET_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# Shared infrastructure and tuning keys documented in .env.example
REDIS_URL=redis://localhost:6379
BRIAN_API_KEY=get_from_brianknows.org
RETENTION_USER_EVENTS_DAYS=7
USER_EVENT_STREAM_MAX_PER_USER=5000

# WebSocket streaming (mirrors .env.example defaults)
WS_PATH=/api/v1/ws
WS_HEARTBEAT_INTERVAL_MS=30000
WS_IDLE_TIMEOUT_MS=90000
WS_MAX_BUFFERED_EVENTS=256
WS_MAX_BUFFERED_BYTES=1048576
WS_MAX_CONNECTIONS_PER_USER=5
WS_HANDSHAKE_MAX=30
WS_HANDSHAKE_WINDOW_MS=60000
WS_MESSAGE_MAX=50
WS_MESSAGE_WINDOW_MS=10000
WS_MAX_MESSAGE_BYTES=4096
WS_REPLAY_MAX_EVENTS=1000
WS_SESSION_RECHECK_MS=60000
WS_COALESCE_WINDOW_MS=250
WS_DRAIN_RETRY_AFTER_MS=2000
WS_EVENT_CHANNEL=neurowealth:user-events
JWT_SEED=generate_with_openssl_rand_base64_48
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
```
